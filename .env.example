# Provider Selection
MODEL_PROVIDER=openai
MODEL=gpt-5.2

# API Keys
OPENAI_API_KEY=replace-with-openai-key
ANTHROPIC_API_KEY=replace-with-anthropic-key

# Model Settings
REASONING_EFFORT=high

# Processing Settings
MAX_OUTPUT_TOKENS=16384
MAX_CONCURRENCY=8
REFINEMENT_PASSES=1

# Cost Tracking (optional - for cost estimation)
# Provider-specific values override the generic values below.
# OpenAI defaults below match published GPT-5.2 rates checked 2026-07-09.
# Update them when selecting another model or when provider pricing changes.
OPENAI_INPUT_PRICE_PER_MTOK=1.75
OPENAI_OUTPUT_PRICE_PER_MTOK=14.0
ANTHROPIC_INPUT_PRICE_PER_MTOK=3.0
ANTHROPIC_OUTPUT_PRICE_PER_MTOK=15.0
INPUT_PRICE_PER_MTOK=1.75
OUTPUT_PRICE_PER_MTOK=14.0
